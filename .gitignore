# Excel raw data (sensitive, don't publish)
*.xlsx
*.xls

# Python cache
__pycache__/
*.pyc

# Temporary / intermediate files
combined_*.xlsx

# IDE
.vscode/
.idea/


# Generated outputs (PNG charts are large, regenerated locally)
output/
*.png
!xiaomi-logo.png
!违规情况/**/*.png
!assets/*.png

# OS
Thumbs.db
Desktop.ini

# UI 一致性校验产物（ui_check.py 生成，落在 _artifacts/）
# 无前导斜杠 = 任意深度都匹配，所以移动 _artifacts/ 后规则依然生效
_ui_*.json
_ui_*.png

# 数据抢修时的临时备份（只留本地，别跟着 git add -A 进去）
*.bak
*.bak-*
